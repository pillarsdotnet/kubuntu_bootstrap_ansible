#
# Export, for node-exporter's textfile collector, the metrics node-exporter
# cannot gather for itself. It runs as root on a timer; node-exporter runs as
# the prometheus user and only reads the directory this writes.
#
# Two kinds of thing end up here:
#
#   CPU throttle counters, which node-exporter does not implement at all.
#   They are what says *why* a package throttled: a rising core count is the
#   die getting hot, while package events with no core events mean something
#   off-die is asserting PROCHOT - a VRM over its limit, or the board's own
#   protection circuit.
#
#   RAPL energy and power limits, which node-exporter does implement but
#   cannot read: energy_uj is mode 0400 root-only, because a readable energy
#   counter is a power side-channel. Rather than widen that to every local
#   account, the counter is read here and published already aggregated.
#
# Everything is written to a temporary file and renamed, because node-exporter
# reads the directory on its own schedule and would parse a half-written file.
set -euo pipefail

out="${1:?usage: $0 <textfile-collector-dir>}/extra_metrics.prom"
tmp="$(mktemp "${out}.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

# The counter name a throttle file maps to, and the help text for it.
emit_throttle_counters() {
  local kind="$1" help="$2" dir cpu
  echo "# HELP node_cpu_${kind}_throttle_total ${help}"
  echo "# TYPE node_cpu_${kind}_throttle_total counter"
  for dir in /sys/devices/system/cpu/cpu[0-9]*/thermal_throttle; do
    [ -r "$dir/${kind}_throttle_count" ] || continue
    cpu="${dir%/thermal_throttle}"
    cpu="${cpu##*/cpu}"
    printf 'node_cpu_%s_throttle_total{cpu="%s"} %s\n' \
      "$kind" "$cpu" "$(cat "$dir/${kind}_throttle_count")"
  done
}

{
  emit_throttle_counters core \
    "Core thermal throttle events since boot (the die itself got hot)."
  emit_throttle_counters package \
    "Package throttle events since boot (includes externally asserted PROCHOT)."

  # Energy is a free-running microjoule counter that wraps; published in
  # joules as a counter so a rate() over it reads as watts.
  echo "# HELP node_rapl_zone_energy_joules_total RAPL energy counter, in joules."
  echo "# TYPE node_rapl_zone_energy_joules_total counter"
  for zone in /sys/class/powercap/intel-rapl:*; do
    [ -r "$zone/energy_uj" ] || continue
    name="$(cat "$zone/name" 2>/dev/null)" || continue
    printf 'node_rapl_zone_energy_joules_total{zone="%s",path="%s"} %s\n' \
      "$name" "$(basename "$zone")" \
      "$(awk '{printf "%.6f", $1 / 1000000}' "$zone/energy_uj")"
  done

  # The ceilings those counters are measured against: without them a power
  # curve cannot be read as "at the limit" or "nowhere near it".
  echo "# HELP node_rapl_zone_power_limit_watts RAPL constraint power limit, in watts."
  echo "# TYPE node_rapl_zone_power_limit_watts gauge"
  for zone in /sys/class/powercap/intel-rapl:*; do
    name="$(cat "$zone/name" 2>/dev/null)" || continue
    for limit in "$zone"/constraint_*_power_limit_uw; do
      [ -r "$limit" ] || continue
      index="${limit##*/constraint_}"
      index="${index%%_*}"
      constraint="$(cat "$zone/constraint_${index}_name" 2>/dev/null || echo "$index")"
      value="$(cat "$limit")"
      [ "$value" -gt 0 ] 2>/dev/null || continue
      printf 'node_rapl_zone_power_limit_watts{zone="%s",constraint="%s"} %.3f\n' \
        "$name" "$constraint" "$(awk -v v="$value" 'BEGIN{printf "%.6f", v / 1000000}')"
    done
  done
} > "$tmp"

chmod 0644 "$tmp"
mv -f "$tmp" "$out"
trap - EXIT
