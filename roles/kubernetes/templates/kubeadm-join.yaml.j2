---
apiVersion: kubeadm.k8s.io/v1beta3
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: "{{ hostvars[cp_host]['tailscale_ip'] }}:6443"
    token: "{{ join_token_result.stdout | trim }}"
    caCertHashes:
      - "sha256:{{ ca_cert_hash_result.stdout | trim }}"
nodeRegistration:
  criSocket: "unix:///run/containerd/containerd.sock"
  kubeletExtraArgs:
    node-ip: "{{ tailscale_ip }}"
