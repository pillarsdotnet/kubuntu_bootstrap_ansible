---
apiVersion: kubeadm.k8s.io/v1beta3
kind: ClusterConfiguration
kubernetesVersion: "{{ kubeadm_version_result.stdout | trim }}"
clusterName: kubernetes
controlPlaneEndpoint: "{{ kubernetes_vip }}:6443"
networking:
  podSubnet: "{{ kubernetes_pod_cidr }}"
  serviceSubnet: "{{ kubernetes_service_cidr }}"
  dnsDomain: "cluster.local"
apiServer:
  certSANs:
    - "{{ tailscale_ip }}"
    - "{{ kubernetes_vip }}"
    - "127.0.0.1"
    - "localhost"
    - "{{ inventory_hostname }}"
---
apiVersion: kubeadm.k8s.io/v1beta3
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: "{{ tailscale_ip }}"
  bindPort: 6443
nodeRegistration:
  criSocket: "unix:///run/containerd/containerd.sock"
  kubeletExtraArgs:
    node-ip: "{{ tailscale_ip }}"
