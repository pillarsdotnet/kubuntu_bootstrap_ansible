#
# Keep a read-only btrfs snapshot history of each share.
#
# Read /etc/fileserver-snapshot.conf for the subvolumes and the thresholds.
# Each run leaves SNAPSHOT_DIR/<share>/<UTC timestamp> as a read-only snapshot
# of the share as it was at that instant.
#
# This replaces the rsync consolidation on a btrfs host, and it is worth being
# precise about why, because "it is faster" is the least of it. Measured on
# acermagic 2026-11-25:
#
#   - The copy created duplication that the nightly duperemove pass then had
#     to find and undo. A snapshot shares every extent at creation - two
#     identical 16 MiB files read "exclusive=0 shared=16MiB" immediately - so
#     the duplication is never written in the first place. Less I/O, less
#     write wear, and nothing for dedup to reclaim afterwards.
#
#   - A snapshot is atomic. rsync walks a tree for minutes and can capture it
#     half-written; that is what the quiet period below is defending against,
#     and with an atomic snapshot it stops being a correctness requirement.
#     It is kept anyway, because filesystem-consistent is not the same as
#     application-consistent: a snapshot taken mid-wbadmin holds an
#     incomplete system image, which is a poor restore point even though it
#     is a perfectly consistent one.
#
#   - A read-only snapshot cannot be written through the share by anybody,
#     whatever their permissions - appending to one and unlinking from one
#     both fail with "Read-only file system" even as root. That is the whole
#     of the protection a compromised Windows client needs to be denied, and
#     it costs nothing. It is also strictly better than chattr +i, which
#     blocks duperemove's dedupe ioctl: measured, "Operation not permitted",
#     nothing shared, and duperemove still exits 0 about it.
#
# What it does NOT buy is redundancy. A snapshot shares extents with the live
# data, so one disk failure takes the share and its whole history together.
# Neither did the copy it replaces - rsync --link-dest shares inodes for every
# unchanged file - so this is the same non-redundancy, more honestly labelled.
# The way out is btrfs send to another filesystem, which having subvolumes at
# all is the prerequisite for.
#
# Two interlocks, each because the obvious version is wrong:
#
#   - A share that is not a subvolume is reported and skipped, never silently
#     passed over. btrfs can only snapshot a subvolume, and a share that was
#     created as a plain directory has to be converted by hand because that
#     means moving its data. Saying so every run is how that gets finished.
#
#   - Pruning only ever considers names matching the timestamp pattern this
#     script writes, and only deletes them with "btrfs subvolume delete".
set -euo pipefail

conf="/etc/fileserver-snapshot.conf"

# --conf so a policy can be tried against a scratch directory without
# disturbing the installed one. Parsed before the file is sourced, because
# the file is what sets everything below.
while [ $# -gt 0 ]; do
  case "$1" in
    --conf)
      [ $# -ge 2 ] || { echo "usage: $0 [--conf FILE]" >&2; exit 2; }
      conf="$2"
      shift 2
      ;;
    *) echo "usage: $0 [--conf FILE]" >&2; exit 2 ;;
  esac
done

QUIET_MINUTES=15
KEEP=48
MIN_FREE_GB=500
SNAPSHOT_DIR=""
SUBVOLUMES=""
# shellcheck source=/dev/null
[ -r "$conf" ] && . "$conf"

# The only names this script will ever create or delete.
stamp_glob='[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z'
stamp_re='^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{6}Z$'

log() {
  logger -t fileserver-snapshot -- "$*" || true
  printf 'fileserver-snapshot: %s\n' "$*"
}

failures=0

free_gb() {
  local path="$1" avail
  avail="$(df --output=avail "$path" | tail -1 | tr -d ' ')"
  printf '%s' "$((avail / 1024 / 1024))"
}

# Newest CHANGE time anywhere under the share, in seconds since the epoch.
# Empty when it holds no files at all.
#
# ctime, not mtime. File History preserves the timestamps of the files it
# copies, so a file written this second carries whatever mtime it had on the
# client: measured on acermagic 2026-11-25, 129 files written in the previous
# three minutes all read 2025-03-24, and the quiet check believed the share
# had been idle for 11 minutes while Windows was streaming into it. ctime is
# set by the kernel on write and an SMB client cannot set it, so it cannot be
# backdated to hurry a torn snapshot either.
newest_change() {
  find "$1" -type f -printf '%C@\n' 2>/dev/null | sort -rn | head -1 | cut -d. -f1
}

is_subvolume() {
  btrfs subvolume show "$1" >/dev/null 2>&1
}

snapshot() {
  local share="$1" name history stamp
  name="$(basename -- "$share")"
  history="$SNAPSHOT_DIR/$name"

  if [ ! -d "$share" ]; then
    log "WARNING: $share does not exist; skipping"
    return 0
  fi

  # Reported rather than skipped quietly: this is the state a share is left in
  # between being created as a directory and being converted, and the
  # conversion cannot be automated because it moves data.
  if ! is_subvolume "$share"; then
    log "WARNING: $share is not a btrfs subvolume, so it cannot be snapshotted and has no history here. Convert it in a quiet window with: fileserver-subvol --path $share --move"
    return 0
  fi

  local newest
  newest="$(newest_change "$share")"
  if [ -z "$newest" ]; then
    log "$share is empty; nothing to snapshot"
    return 0
  fi

  local age_min=$((($(date +%s) - newest) / 60))
  if [ "$age_min" -lt "$QUIET_MINUTES" ]; then
    log "$share changed ${age_min}m ago, under the ${QUIET_MINUTES}m quiet period; leaving it alone"
    return 0
  fi

  # A snapshot costs nothing at creation, but a retained one pins the extents
  # its share has since replaced, so the floor still applies.
  local avail
  avail="$(free_gb "$SNAPSHOT_DIR")"
  if [ "$avail" -lt "$MIN_FREE_GB" ]; then
    log "REFUSING: $SNAPSHOT_DIR has ${avail} GiB free, below the ${MIN_FREE_GB} GiB floor"
    return 1
  fi

  mkdir -p -- "$history"
  stamp="$(date -u +%Y-%m-%dT%H%M%SZ)"

  if [ -e "$history/$stamp" ]; then
    log "$history/$stamp already exists; nothing to do this second"
    return 0
  fi

  # -r for read-only, which is the point: no permission on any share can write
  # to it, because the filesystem itself refuses.
  if ! btrfs subvolume snapshot -r -- "$share" "$history/$stamp" >/dev/null; then
    log "ERROR: could not snapshot $share to $history/$stamp"
    return 1
  fi

  log "$share -> $history/$stamp"

  # Prune, newest kept. Only our own timestamps are candidates, and only ever
  # by subvolume delete.
  local count
  count="$(find "$history" -mindepth 1 -maxdepth 1 -name "$stamp_glob" -printf '%f\n' 2>/dev/null | wc -l)"
  if [ "$count" -gt "$KEEP" ]; then
    find "$history" -mindepth 1 -maxdepth 1 -name "$stamp_glob" -printf '%f\n' 2>/dev/null \
      | sort | head -n "$((count - KEEP))" \
      | while read -r old; do
          [[ "$old" =~ $stamp_re ]] || { log "refusing to prune unexpected name: $old"; continue; }
          # ${var:?} so this can never be asked to delete the history root.
          if btrfs subvolume delete -- "${history:?}/${old:?}" >/dev/null; then
            log "pruned $history/$old"
          else
            log "ERROR: could not prune $history/$old"
          fi
        done
  fi
}

[ -n "$SNAPSHOT_DIR" ] || { log "no SNAPSHOT_DIR configured in $conf; nothing to do"; exit 0; }
[ -n "$SUBVOLUMES" ] || { log "no subvolumes configured in $conf; nothing to do"; exit 0; }
[ -d "$SNAPSHOT_DIR" ] || { log "ERROR: $SNAPSHOT_DIR does not exist"; exit 1; }

while read -r line; do
  line="${line%%#*}"
  [ -n "${line// /}" ] || continue
  snapshot "${line// /}" || failures=$((failures + 1))
done <<< "$SUBVOLUMES"

[ "$failures" -eq 0 ] || { log "$failures share(s) failed"; exit 1; }
