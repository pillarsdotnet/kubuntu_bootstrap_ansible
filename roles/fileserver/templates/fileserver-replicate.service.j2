# Managed by Ansible (roles/fileserver). Do not edit by hand.
[Unit]
Description=Consolidate share backups into timestamped snapshots
Documentation=man:rsync(1)
After=smbd.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/fileserver-replicate
# Runs as root so rsync -a can preserve the ownership the shares rely on: a
# snapshot owned by root would be unreadable through SMB by the account that
# is supposed to be able to check it.
User=root
# A snapshot of a system image is large and slow, and must not be killed
# part-written - the script's .partial naming survives that, but finishing is
# better. Nothing here is interactive, so there is no reason to time it out
# aggressively.
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=idle
