# Managed by Ansible (roles/fileserver). Do not edit by hand.
# The packaged smb.conf is 9 kB of commented examples; this is only what this
# host actually uses. "testparm -s" is run against it before it is installed,
# so a syntax error fails the play rather than the service.

[global]
    workgroup = {{ fileserver_workgroup }}
    server string = {{ fileserver_server_string }}
    server role = standalone server

    # Authentication. "map to guest = never" matters: without it a bad
    # username is silently downgraded to the guest account instead of being
    # refused, which turns a typo into an anonymous session.
    security = user
    map to guest = never

    server min protocol = {{ fileserver_min_protocol }}
    smb encrypt = {{ fileserver_encrypt }}
{% if fileserver_interfaces | length > 0 %}

    # Keep the shares off the docker and Kubernetes bridges. See the defaults:
    # this binds by interface, so a global IPv6 address on a listed interface
    # is still bound, and the host lists below are what gate it.
    interfaces = {{ fileserver_interfaces | join(' ') }}
    bind interfaces only = yes
{% endif %}
{% if fileserver_hosts_allow | length > 0 %}

    # An allow list only means something with a deny to fall back to, and the
    # deny has to name both families - see fileserver_hosts_deny.
    hosts allow = {{ fileserver_hosts_allow | join(' ') }}
    hosts deny = {{ fileserver_hosts_deny | join(' ') }}
{% endif %}

    # This host is not a print server, and a file server that advertises
    # printers invites Windows to probe for drivers it will not find.
    load printers = no
    printing = bsd
    printcap name = /dev/null
    disable spoolss = yes

    logging = systemd
    log level = 1
{% for share in fileserver_shares %}

[{{ share.name }}]
{% if share.comment is defined %}
    comment = {{ share.comment }}
{% endif %}
    path = {{ share.path | default(fileserver_root + '/' + share.name) }}
    browseable = yes
    read only = no
    guest ok = no
    valid users = {{ (share.users + share.ro_users | default([])) | join(' ') }}
{% if share.ro_users | default([]) | length > 0 %}
    # "read only = no" above is the share default; these two lists then say
    # who it actually applies to. Without the read list an ro_users account
    # would inherit the share default and be able to write.
    write list = {{ share.users | join(' ') }}
    read list = {{ share.ro_users | join(' ') }}
{% endif %}
    # Group-writable so a share can be opened to a second account later, and
    # not world-readable: these are backups. No "force user", so a file is
    # owned by whoever wrote it rather than by one shared identity.
    create mask = 0660
    directory mask = 0770
    force group = {{ fileserver_group }}
{% endfor %}
