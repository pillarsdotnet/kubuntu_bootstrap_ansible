# Managed by kubuntu_bootstrap_ansible (roles/calibre).
# TLS terminates here and the server is proxied on loopback.
{% if calibre_tls_cert | length > 0 %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ calibre_domain }};
    # The ACME path stays on port 80 so a renewal does not depend on the
    # certificate it is renewing, even where DNS-01 is what actually issues.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
{% if calibre_nginx_listen_addresses | length > 0 %}
{% for listen_address in calibre_nginx_listen_addresses %}
    listen {{ listen_address }}:443 ssl;
{% endfor %}
{% else %}
    listen 443 ssl;
    listen [::]:443 ssl;
{% endif %}
    http2 on;
    server_name {{ calibre_domain }};

    ssl_certificate     {{ calibre_tls_cert }};
    ssl_certificate_key {{ calibre_tls_key }};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:2m;
    ssl_session_timeout 1h;
{% else %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ calibre_domain }};
{% endif %}

    client_max_body_size {{ calibre_client_max_body_size }};

    location / {
        proxy_pass http://127.0.0.1:{{ calibre_port }};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # A slow phone pulling a large EPUB over a weak link must not be cut
        # off mid-download.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
