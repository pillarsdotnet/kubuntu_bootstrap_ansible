# Managed by kubuntu_bootstrap_ansible (roles/foundry).
# TLS terminates here and Foundry is proxied on loopback. TLS is effectively
# required: a browser refuses to upgrade to a plain ws:// socket from an
# https page, so without it the table loads and then never connects.
{% if foundry_tls_cert | length > 0 %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ foundry_domain }};
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
{% if foundry_nginx_listen_addresses | length > 0 %}
{% for listen_address in foundry_nginx_listen_addresses %}
    listen {{ listen_address }}:443 ssl;
{% endfor %}
{% else %}
    listen 443 ssl;
    listen [::]:443 ssl;
{% endif %}
    http2 on;
    server_name {{ foundry_domain }};

    ssl_certificate     {{ foundry_tls_cert }};
    ssl_certificate_key {{ foundry_tls_key }};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:2m;
    ssl_session_timeout 1h;
{% else %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ foundry_domain }};
{% endif %}

    client_max_body_size {{ foundry_client_max_body_size }};

    location / {
        proxy_pass http://127.0.0.1:{{ foundry_port }};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The two headers the game connection depends on. See the map in
        # conf.d: without them the page loads and the table never joins.
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $foundry_connection_upgrade;
        # A session sits idle between turns and must not be disconnected for
        # it.
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
